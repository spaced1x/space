# ─────────────────────────────────────────────────────────────────────────────
# SPACE — environment contract
#
# ONLY permanent secrets and immutable runtime facts live here. Every
# operational setting (execution windows, buffers, trade sizes, max positions,
# retries, order modes) is configured inside SPACE from the Operations Desk and
# stored in the database.
#
# Validated once at startup. Invalid values abort the boot with an explicit
# error; missing venue secrets keep the engine limited to OBSERVE.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
SPACE_ENVIRONMENT=V1_TESTNET          # V1_TESTNET | V2_MAINNET — same code, different credentials
PORT=8080

# Storage
DB_PATH=./data/space.db               # SQLite (WAL). Back up the file, restore, run.

# Logging
LOG_LEVEL=info                        # debug | info | warn | error
LOG_DIR=./logs
LOG_MAX_BYTES=10000000
LOG_MAX_FILES=5

# Polymarket CLOB v2
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Polymarket documents exactly one CLOB host (no staging/testnet exists).
# V1_TESTNET executes on the paper venue; V2_MAINNET trades here for real.
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# Public CLOB market data WebSocket (no credentials, used by both V1 and V2)
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Address holding the collateral (proxy/safe). Defaults to WALLET_ADDRESS.
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = email/magic proxy, 2 = browser wallet proxy
POLYMARKET_SIGNATURE_TYPE=0

# Wallet / chain
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
POLYGON_RPC_URL=

# Market data
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOL=BTCUSDT                # symbol is lower-cased for the stream automatically
CHAINLINK_BTC_USD_FEED=0xc907E116054Ad103354f2D350FD2514433D57F6f   # Polygon BTC/USD aggregator
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Settlement TWAP providers.
# The active provider is persisted in the database (twap.active_provider) and
# defaults to RTDS. Binance above is a display/diagnostics feed only and is
# never used as a settlement source.
RTDS_ENABLED=true
RTDS_WS_URL=                          # e.g. wss://<polymarket-rtds-host>
RTDS_API_KEY=
RTDS_API_SECRET=
RTDS_CHANNEL=                         # channel name, or a full JSON subscription payload
RTDS_SYMBOL=BTC
RTDS_AUTH_TYPE=none                   # none | api_key | bearer | hmac | query

# Second provider, registered and observable, awaiting credentials.
CHAINLINK_ENABLED=false
CHAINLINK_API_KEY=
CHAINLINK_API_SECRET=
CHAINLINK_STREAM_ID=
CHAINLINK_WS_URL=
CHAINLINK_HTTP_URL=

# Telegram operator interface (optional; absence degrades, never blocks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=