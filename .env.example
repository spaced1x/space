# ─────────────────────────────────────────────────────────────────────────────
# SPACE — environment contract
#
# ONLY permanent secrets and immutable runtime facts live here. Every
# operational setting (execution windows, buffers, trade sizes, max positions,
# retries, order modes) is configured inside SPACE from the Operations Desk and
# stored in the database.
#
# Validated once at startup. Invalid values abort the boot with an explicit
# error; missing venue secrets keep the engine limited to OBSERVE.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
SPACE_ENVIRONMENT=V1_TESTNET          # V1_TESTNET | V2_MAINNET — same code, different credentials
PORT=3000

# Storage
DB_PATH=./data/space.db               # SQLite (WAL). Back up the file, restore, run.

# Logging
LOG_LEVEL=info                        # debug | info | warn | error
LOG_DIR=./logs
LOG_MAX_BYTES=10000000
LOG_MAX_FILES=5

# Single-operator auth
OPERATOR_PASSWORD_HASH=               # argon2id hash — never a plaintext password
SESSION_SECRET=

# Polymarket CLOB v2
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Wallet / chain
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
POLYGON_RPC_URL=

# Market data
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOL=btcusdt                # lower-case stream symbol
CHAINLINK_BTC_USD_FEED=0xc907E116054Ad103354f2D350FD2514433D57F6f   # Polygon BTC/USD aggregator
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Telegram operator interface (optional; absence degrades, never blocks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=